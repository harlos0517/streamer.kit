generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  TWITCH
  YOUTUBE
}

model Viewer {
  id            String    @id @default(cuid())
  displayName   String?
  avatarUrl     String?
  firstSeenAt   DateTime  @default(now())
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities   Identity[]
  wallets      Wallet[]
  transactions Transaction[]

  @@map("viewers")
}

model Identity {
  id                  String   @id @default(cuid())
  platform            Platform
  platformUserId      String
  platformDisplayName String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  viewerId String
  viewer   Viewer @relation(fields: [viewerId], references: [id])

  @@unique([platform, platformUserId])
  @@index([viewerId])
  @@map("identities")
}

model Currency {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  wallets      Wallet[]
  transactions Transaction[]

  @@map("currencies")
}

model Wallet {
  id        String   @id @default(cuid())
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  viewerId String
  viewer   Viewer @relation(fields: [viewerId], references: [id])

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([viewerId, currencyId])
  @@map("wallets")
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Int
  reason    String
  source    String?
  metadata  Json?
  createdAt DateTime @default(now())

  viewerId String
  viewer   Viewer @relation(fields: [viewerId], references: [id])

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@index([viewerId])
  @@index([currencyId])
  @@map("transactions")
}
