# Database
# These defaults are fine for local self-hosting on your own machine.
# If you deploy this to a VPS/cloud server or otherwise expose it beyond your
# own LAN, change POSTGRES_PASSWORD - port 5432 with a default password is a
# common target for automated scanners.
POSTGRES_USER=streamerkit
POSTGRES_PASSWORD=streamerkit
POSTGRES_DB=streamerkit
DATABASE_URL="postgresql://streamerkit:streamerkit@localhost:5432/streamerkit?schema=public"

# Streamer.bot WebSocket
STREAMERBOT_WS_HOST=127.0.0.1 # This is hardcoded in docker-compose.yml, so changing it here won't have any effect.
STREAMERBOT_WS_PORT=8080
STREAMERBOT_WS_ENDPOINT=/
STREAMERBOT_WS_PASSWORD=

# Name of the Streamer.bot Action running packages/core/streamerbot/BridgeAction.cs.
# Leave empty until you've created that Action - the CPH Bridge just stays unusable until then.
STREAMERBOT_BRIDGE_ACTION_NAME="Streamer.kit Bridge"

# HTTP API
HTTP_PORT=3000

# Docker Compose only: URL the dashboard's browser bundle should call.
# Baked in at `docker compose build` time (see apps/dashboard/Dockerfile).
DASHBOARD_API_URL=http://localhost:3000
